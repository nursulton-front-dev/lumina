# Скопируйте файл в .env и подставьте значения из своего проекта Supabase.
# Оба значения публичные: они уходят в браузер, это нормально и предусмотрено Supabase.
# Настройки → API → Project URL и Project API keys → anon public.
VITE_SUPABASE_URL=https://ваш-проект.supabase.co
VITE_SUPABASE_ANON_KEY=ваш-anon-ключ

# AI-ассистент выключен по умолчанию. Чтобы включить: задеплоить функцию ai с секретом
# DEEPSEEK_API_KEY (SETUP.md, раздел 4) и поставить здесь true. Без флага в приложении
# нет ни кнопки ассистента, ни обращений к прокси.
VITE_ASSISTANT_ENABLED=false

# Ключ DeepSeek здесь НЕ указывается: он живёт только в секретах Supabase Edge Function.
