{
  "name": "focus-notebook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"supabase/functions/**/*.ts\"",
    "typecheck": "tsc -b",
    "test:live": "sh -c 'set -a; [ -f \"$HOME/.config/focus-notebook/deepseek.env\" ] && . \"$HOME/.config/focus-notebook/deepseek.env\"; set +a; vitest run src/ai/live'",
    "bot:deploy": "cd bot && wrangler deploy",
    "bot:dev": "cd bot && wrangler dev --test-scheduled"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260914.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.2"
  }
}
